# Copy to .env and fill in. NEVER commit the real .env. All keys stay server-side.

# Warp freight API — this round you run the local mock (node mock/server.js).
# No real key needed; the mock ignores it.
WARP_API_KEY=mock
WARP_API_BASE_URL=http://localhost:3001

# Speech-to-text — Groq's Whisper endpoint (fast, free tier).
GROQ_API_KEY=

# Brain / tool-calling — OpenAI GPT-4o-mini.
OPENAI_API_KEY=

# Text-to-speech — ElevenLabs.
ELEVENLABS_API_KEY=
# Default is "Sarah", a premade voice available to every account on the free tier.
# Shared/library voices need to be added to your account first or they 402 via the API —
# see GET https://api.elevenlabs.io/v1/voices for what's already usable on your account.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Local server port.
PORT=8787
